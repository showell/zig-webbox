-- **THE GIT PRELUDE** (metal-vmm QUEUE 233, chunk 3; the dogfood design's
-- "Git"): git over `run`, no reading of `.git` itself. A `repo` is a
-- Shale path (`""` the root, `repos:dog-park`), given to git as `-C` by
-- its `real` path. The reading calls give data and take no lock (git's
-- `--no-optional-locks`: a `status` never rewrites the index, though a
-- `diff` still refreshes its stat data, as git 2.43 does); the
-- changing ones print what git said when it fails. Either way a git error
-- stops the run, naming the call as typed and git's first line. Each call
-- has 60 seconds unless its options say `timeout_ms`.

-- Whether `x` is a string: a string builtin takes it (Shale has no
-- `type`).
function git_text(x)
  return lower(x)
end

-- `opts`' keys, each one `allowed`: else a failure naming the first that
-- is not.
function git_opts(name, opts, allowed)
  if opts == nil then return nil end
  for k in keys(opts) do
    local ok = false
    for a in allowed do
      if a == k then ok = true end
    end
    if not ok then
      local said = allowed[1]
      if #allowed > 1 then said = join(take(allowed, #allowed - 1), ", ") .. " and " .. allowed[#allowed] end
      fail("`" .. name .. "` takes " .. said .. ", not `" .. k .. "`")
    end
  end
  return nil
end

-- One git command in `repo`: its result when it exited 0, else a stop.
-- A reading call keeps git's whole output; a changing one its ends, and
-- prints them when it fails.
function git_call(repo, args, opts, reading, stdin)
  local shown = "`git " .. join(args, " ") .. "`"
  if repo ~= "" and not is_dir(repo) then fail(shown .. ": " .. repo .. " is not a folder") end
  local argv = {"git", "-C", real(repo), "-c", "color.ui=never"}
  if reading then push(argv, "--no-optional-locks") end
  for a in args do push(argv, a) end
  local o = {timeout_ms = 60000, env = {GIT_TERMINAL_PROMPT = "0"}}
  if opts ~= nil and has_key(opts, "timeout_ms") then o.timeout_ms = opts.timeout_ms end
  if reading then o.whole = 16777216 else
    o.head = 10
    o.tail = 10
  end
  if stdin ~= nil then o.stdin = stdin end
  local r = run(argv, o)
  if r.ended == "exit" and r.code == 0 then return r end
  local said = lines(r.out)
  local first = ""
  if #said > 0 then first = ": " .. said[1] end
  if not reading and r.out ~= "" then print(trim(r.out)) end
  if r.ended == "exit" then fail(shown .. " exited " .. r.code .. first) end
  if r.ended == "timeout" then fail(shown .. " timed out") end
  fail(shown .. " was ended by a signal")
end

-- ── reading ─────────────────────────────────────────────────────────────

-- Every changed path, `{code, path[, from]}`: `code` git's two letters
-- (`" M"`, `"A "`, `"??"` untracked), `from` a rename's old path.
function git_status(repo)
  local parts = split(git_call(repo, {"status", "--porcelain=v1", "-z"}, nil, true, nil).out, "\0")
  local got = {}
  local i = 1
  while i <= #parts do
    local e = parts[i]
    if e ~= "" then
      local item = {code = sub(e, 1, 2), path = sub(e, 4)}
      local x = sub(e, 1, 1)
      if x == "R" or x == "C" then
        i = i + 1
        item.from = parts[i]
      end
      push(got, item)
    end
    i = i + 1
  end
  return got
end

-- The commits, newest first, each a map of `fields` (hash, the short
-- one; subject; date, the author's, ISO; author): `n` of them, of a
-- `range` (`"a..b"`) or from a `ref`.
function git_log(repo, opts?)
  git_opts("git_log", opts, {"n", "range", "ref", "fields", "timeout_ms"})
  local fields = {"hash", "subject", "date", "author"}
  if opts ~= nil and has_key(opts, "fields") then fields = opts.fields end
  local format = {hash = "%h", subject = "%s", date = "%aI", author = "%an"}
  local spec = {}
  for f in fields do
    if not has_key(format, f) then fail("`git_log`'s fields are hash, subject, date and author, not `" .. f .. "`") end
    push(spec, format[f])
  end
  local args = {"log", "--format=" .. join(spec, "%x1f") .. "%x1e"}
  if opts ~= nil then
    if has_key(opts, "n") then push(args, "-n" .. opts.n) end
    if has_key(opts, "range") then push(args, opts.range) end
    if has_key(opts, "ref") then push(args, opts.ref) end
  end
  push(args, "--")
  local got = {}
  for record in split(git_call(repo, args, opts, true, nil).out, "\x1e\n") do
    if record ~= "" then
      local values = split(record, "\x1f")
      local c = {}
      for i = 1, #fields do c[fields[i]] = values[i] end
      push(got, c)
    end
  end
  return got
end

-- The diff as text: of the work tree, or a `range`, of `paths` only, or
-- its `stat`.
function git_diff(repo, opts?)
  git_opts("git_diff", opts, {"range", "paths", "stat", "timeout_ms"})
  local args = {"diff", "--no-ext-diff"}
  if opts ~= nil then
    if get(opts, "stat", false) then push(args, "--stat") end
    if has_key(opts, "range") then push(args, opts.range) end
  end
  push(args, "--")
  if opts ~= nil and has_key(opts, "paths") then
    for p in opts.paths do push(args, p) end
  end
  return git_call(repo, args, opts, true, nil).out
end

-- `git show`'s text: a commit, or a file at one (`"HEAD:src/x.zig"`).
function git_show(repo, what)
  return git_call(repo, {"show", what}, nil, true, nil).out
end

-- The tracked paths.
function git_ls_files(repo)
  local got = {}
  for p in split(git_call(repo, {"ls-files", "-z"}, nil, true, nil).out, "\0") do
    if p ~= "" then push(got, p) end
  end
  return got
end

-- Whether nothing is changed, staged or untracked.
function git_is_clean(repo)
  return #git_status(repo) == 0
end

-- HEAD's short hash.
function git_head(repo)
  return trim(git_call(repo, {"rev-parse", "--short", "HEAD"}, nil, true, nil).out)
end

-- ── changing ────────────────────────────────────────────────────────────

-- A commit of `msg` (given on stdin, so any text), adding first: the
-- tracked files' changes (`add = "tracked"`, `-a`), everything (`"all"`,
-- `add -A`), the paths listed, or nothing (what is staged; a merge's).
-- HEAD's short hash after.
function git_commit(repo, msg, opts?)
  git_opts("git_commit", opts, {"add", "timeout_ms"})
  local add = nil
  if opts ~= nil then add = get(opts, "add") end
  local args = {"commit", "-q"}
  if add ~= nil and attempt(git_text, add).ok then
    if add ~= "tracked" and add ~= "all" then fail("`git_commit`'s `add` is \"tracked\", \"all\" or a list of paths, not \"" .. add .. "\"") end
  end
  if add == nil then
    add = nil
  elseif not attempt(git_text, add).ok then
    local a = {"add", "--"}
    for p in add do push(a, p) end
    git_call(repo, a, opts, false, nil)
  elseif add == "tracked" then
    push(args, "-a")
  else
    git_call(repo, {"add", "-A"}, opts, false, nil)
  end
  push(args, "-F")
  push(args, "-")
  git_call(repo, args, opts, false, msg)
  return git_head(repo)
end

-- Push: to the branch's upstream, or `{remote, branch}` (the remote
-- `origin` unless named), which becomes its upstream (`push -u`).
function git_push(repo, opts?)
  git_opts("git_push", opts, {"remote", "branch", "timeout_ms"})
  local args = {"push", "-q"}
  if opts ~= nil then
    if has_key(opts, "branch") then push(args, "-u") end
    if has_key(opts, "remote") then push(args, opts.remote) elseif has_key(opts, "branch") then push(args, "origin") end
    if has_key(opts, "branch") then push(args, opts.branch) end
  end
  git_call(repo, args, opts, false, nil)
  return nil
end

-- Fetch: the upstream, or `{all = true}`.
function git_fetch(repo, opts?)
  git_opts("git_fetch", opts, {"all", "timeout_ms"})
  local args = {"fetch", "-q"}
  if opts ~= nil and get(opts, "all", false) then push(args, "--all") end
  git_call(repo, args, opts, false, nil)
  return nil
end

-- Pull, fast-forward only.
function git_pull_ff(repo)
  git_call(repo, {"pull", "-q", "--ff-only"}, nil, false, nil)
  return nil
end

-- Merge `ref`, fast-forward only.
function git_merge_ff(repo, ref)
  git_call(repo, {"merge", "-q", "--ff-only", ref}, nil, false, nil)
  return nil
end

-- A worktree at `dir` (a Shale path): of `branch`, or a `new` branch.
function git_worktree_add(repo, dir, opts?)
  git_opts("git_worktree_add", opts, {"branch", "new", "timeout_ms"})
  local args = {"worktree", "add", "-q"}
  local branch = nil
  local new = false
  if opts ~= nil then
    branch = get(opts, "branch")
    new = get(opts, "new", false)
  end
  if new then
    if branch == nil then fail("`git_worktree_add`: `new` needs the `branch` to make") end
    push(args, "-b")
    push(args, branch)
  end
  push(args, real(dir))
  if branch ~= nil and not new then push(args, branch) end
  git_call(repo, args, opts, false, nil)
  return nil
end

-- The worktree at `dir` removed (`force`: its changes too).
function git_worktree_remove(repo, dir, opts?)
  git_opts("git_worktree_remove", opts, {"force", "timeout_ms"})
  local args = {"worktree", "remove"}
  if opts ~= nil and get(opts, "force", false) then push(args, "--force") end
  push(args, real(dir))
  git_call(repo, args, opts, false, nil)
  return nil
end

-- A branch deleted: merged, or any (`force`).
function git_branch_delete(repo, name, opts?)
  git_opts("git_branch_delete", opts, {"force", "timeout_ms"})
  local flag = "-d"
  if opts ~= nil and get(opts, "force", false) then flag = "-D" end
  git_call(repo, {"branch", "-q", flag, name}, opts, false, nil)
  return nil
end
