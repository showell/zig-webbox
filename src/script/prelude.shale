-- **THE PRELUDE** (metal-vmm QUEUE 220): functions every script has,
-- written in Shale. Each part of their work is one builtin call under its
-- cap, so a run's slices and budgets are as if the script had written them
-- itself. A script may declare a function of the same name: its calls are
-- then its own.

-- Every entry `walk` gives, a part at a time: one call considers at most
-- the call-entries cap (256) and ends its part with a `more` entry, whose
-- path is where the next part starts. `opts` is not changed.
function walk_all(path, opts)
  local o = {after = ""}
  for k in keys(opts) do
    if k ~= "after" then o[k] = opts[k] end
  end
  local got = {}
  while true do
    local more = nil
    for e in walk(path, o) do
      if e.kind == "more" then more = e.path else push(got, e) end
    end
    if more == nil then return got end
    o.after = more
  end
end

-- **AS FAR AS THE READS ALLOW** (metal-vmm QUEUE 229): every entry `walk`
-- gives from `opts.after` on, a part at a time, until the walk ends or
-- its reads would leave fewer than `keep` for the rest of the script:
-- `{entries, more, done}`. Not `done`, `more` is the path a later walk goes
-- on after (`opts.after = more`), and every entry up to it is in
-- `entries`. `opts` is not changed.
function walk_upto(path, opts, keep)
  local o = {after = ""}
  for k in keys(opts) do o[k] = opts[k] end
  o.keep_reads = keep
  local got = {}
  while true do
    local more = nil
    for e in walk(path, o) do
      if e.kind == "more" then more = e.path else push(got, e) end
    end
    if more == nil then return {entries = got, more = "", done = true} end
    -- A part that took nothing had no room to: the reads are what is kept.
    if more == o.after then return {entries = got, more = more, done = false} end
    o.after = more
  end
end

-- Whether what is left of the budgets holds `need`, a map of `budget()`'s
-- names (`{reads = 2, read_bytes = 4096}`): the guard before work a
-- budget would stop half done.
function room_for(need)
  local left = budget()
  for k in keys(need) do
    if left[k] < need[k] then return false end
  end
  return true
end

-- **THE FILES A GLOB NAMES** (metal-vmm QUEUE 229): every file whose path
-- matches `pattern` (`match_path`: `**` any parts, `*` and `?` in one),
-- sorted as the walk goes. The walk starts at the pattern's parts before
-- its first wildcard, and passes by hidden names (`.git`, `.zig-cache`)
-- unless `opts` says `{hidden = true}` (QUEUE 233).
function glob(pattern, opts?)
  local skip = ".*"
  if opts ~= nil then
    for k in keys(opts) do
      if k ~= "hidden" then fail("`glob` takes `hidden`, not `" .. k .. "`") end
    end
    if get(opts, "hidden", false) then skip = "" end
  end
  local parts = split(pattern, "/")
  local base = {}
  for p in parts do
    if contains(p, "*") or contains(p, "?") then break end
    push(base, p)
  end
  local from = join(base, "/")
  local got = {}
  if #base == #parts then
    if exists(from) and not is_dir(from) then push(got, from) end
    return got
  end
  if from ~= "" and not exists(from) then return got end
  local o = {kind = "file"}
  if skip ~= "" then o.skip = skip end
  for e in walk_all(from, o) do
    if match_path(e.path, pattern) then push(got, e.path) end
  end
  return got
end

-- How many times `s` occurs in the file, a part at a time: one scan brings
-- at most the call-bytes cap (1 MiB). A stat, then a scan a part.
function count_all(path, s)
  local size = stat(path).size
  local n = 0
  local at = 0
  while at < size do
    n = n + count_in(path, s, at, min(1048576, size - at))
    at = at + 1048576
  end
  return n
end

-- The 0-based offset of the first `s` at or after `at`, or nil: the file a
-- part at a time from `at`, as `find_in`. The first part is scanned at
-- once (a part past the file's end is cut at it); only when it finds
-- nothing is the file stat'ed, to see whether there is more.
function find_next(path, s, at)
  local f = find_in(path, s, at, 1048576)
  if f ~= nil then return f end
  local size = stat(path).size
  at = at + 1048576
  while at < size do
    f = find_in(path, s, at, min(1048576, size - at))
    if f ~= nil then return f end
    at = at + 1048576
  end
  return nil
end
-- All of `l` but its first `n` items, in order (none of a list no longer
-- than `n`): `take`'s other half, so a part of a list is
-- `take(drop(l, from), count)`. A count below 0 is a stop, as `take`'s is.
function drop(l, n)
  if n < 0 then fail("`drop`: a count of " .. n) end
  return last(l, max(0, #l - n))
end
