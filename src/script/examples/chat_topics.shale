-- The chat, topic by topic, without reading a transcript: messages from
-- each topic's count cache, bytes and the last change from the store; the
-- topics with the most messages; those quiet for QUIET_DAYS; and the count
-- caches that are stale. Reads only, and cheap on a site of any size: one
-- read a folder (walk) and one a cache.
--
-- A topic is chat/<a>_<b>/sessions/<sid>.md (a conversation) or
-- chat/channels/<name>/sessions/<sid>.md. Its cache, <sid>.count, is
-- angry-gopher's (chat_count.zig): "<count> <size>" on its first line, the
-- transcript's size when it was counted, then "<offset> <uid>". A cache
-- whose size is not the transcript's is stale: the server recounts it at
-- its next read.

const MOST = 15
const QUIET_DAYS = 90

-- The topic's label from its path's parts, or nil when it is no topic.
function label(parts)
  local n = #parts
  if n < 4 or parts[n - 1] ~= "sessions" or not like(parts[n], "*.md") then return nil end
  local sid = sub(parts[n], 1, #parts[n] - 3)
  if n == 4 then return parts[2] .. " " .. sid end
  if n == 5 and parts[2] == "channels" then return "#" .. parts[3] .. " " .. sid end
  return nil
end

-- A cache's first line as {count, size}; both -1 when it is not two
-- numbers, as the server reads a torn one.
function cache(text)
  local first = lines(text)
  if #first == 0 then return {count = -1, size = -1} end
  local w = words(first[1])
  if #w ~= 2 then return {count = -1, size = -1} end
  return {count = tonumber(w[1]), size = tonumber(w[2])}
end

-- now() is 0 where the host gives no clock (the Linux runner): then
-- nothing is quiet.
local quiet_before = now() - QUIET_DAYS * 86400
if quiet_before < 0 then quiet_before = 0 end
local rows = {}
local quiet = {}
local stale = {}
local messages = 0
local bytes = 0
for e in walk("chat") do
  local topic = nil
  if e.kind == "file" then topic = label(split(e.path, "/")) end
  if topic ~= nil then
    local count_path = sub(e.path, 1, #e.path - 3) .. ".count"
    local c = {count = -1, size = -1}
    if exists(count_path) then c = cache(read(count_path)) end
    local n = 0
    if c.count < 0 then
      push(stale, {topic = topic, bytes = e.size, cache = "none"})
    else
      n = c.count
      if c.size ~= e.size then push(stale, {topic = topic, bytes = e.size, cache = c.count .. " at " .. c.size}) end
    end
    local row = {topic = topic, messages = n, bytes = e.size, size = human(e.size), changed = date(e.modified)}
    push(rows, row)
    messages = messages + n
    bytes = bytes + e.size
    -- A modified time of 0 is one the host doesn't keep.
    if e.modified > 0 and e.modified < quiet_before then push(quiet, row) end
  end
end

print("topics", #rows, "messages", messages, "bytes", human(bytes))
print("")
sort(rows, "messages")
reverse(rows)
local most = {}
for r in rows do
  if #most < MOST then push(most, r) end
end
print(table(most, {"topic", "messages", "size", "changed"}))
print("")
print("quiet for " .. QUIET_DAYS .. " days (unchanged since " .. date(quiet_before) .. "): " .. #quiet)
if #quiet > 0 then print(table(quiet, {"topic", "messages", "changed"})) end
print("")
print("count caches that are stale or missing (the server recounts them): " .. #stale)
if #stale > 0 then print(table(stale, {"topic", "bytes", "cache"})) end
