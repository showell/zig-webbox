-- The chat, topic by topic: messages and bytes; the topics with the most
-- messages; those untouched for QUIET_DAYS; and any topic whose count
-- cache is stale. Reads only, and cheap enough for the whole live chat
-- (about 190 MB): a transcript is read only when it has no count cache
-- and is small.
--
-- A topic is chat/<a>_<b>/sessions/<sid>.md (a conversation) or
-- chat/channels/<name>/sessions/<sid>.md. Beside it, the server keeps
-- <sid>.count: "<count> <size>\n" and a second line (the last message's
-- place and author). The count is its first word; the size is the
-- transcript's size when it was taken, so a size that differs from the
-- transcript's now means the cache is stale.

const MOST = 15
const QUIET_DAYS = 90
-- A transcript with no count cache is counted only below this size.
const SCAN_MOST = 262144
-- Messages are joined by the server's separator; a piece with anything
-- in it is a message (angry-gopher's countBlocks).
const SEP = "\n\n-------------\n"

function count_messages(text)
  local n = 0
  for piece in split(text, SEP) do
    if trim(piece) ~= "" then n = n + 1 end
  end
  return n
end

-- The topic's label from its path's parts, or nil when it is no topic.
function label(parts)
  local n = #parts
  if n < 4 or parts[n - 1] ~= "sessions" or not like(parts[n], "*.md") then return nil end
  local sid = sub(parts[n], 1, #parts[n] - 3)
  if n == 4 then return parts[2] .. " " .. sid end
  if n == 5 and parts[2] == "channels" then return "#" .. parts[3] .. " " .. sid end
  return nil
end

-- now() is 0 where the host gives no clock (the Linux runner): then
-- nothing is untouched.
local quiet_before = now() - QUIET_DAYS * 86400
if quiet_before < 0 then quiet_before = 0 end
local rows = {}
local quiet = {}
local stale = {}
local uncounted = 0
local messages = 0
local bytes = 0
local cut = false
for e in walk("chat") do
  local topic = nil
  if e.kind == "file" then topic = label(split(e.path, "/")) end
  if topic ~= nil then
    if budget().reads < 4 then
      cut = true
      break
    end
    local count_path = sub(e.path, 1, #e.path - 3) .. ".count"
    local n = -1
    if exists(count_path) then
      local w = words(read(count_path))
      n = tonumber(w[1])
      if tonumber(w[2]) ~= e.size then push(stale, {topic = topic, cache = n, taken_at = tonumber(w[2]), size = e.size}) end
    elseif e.size <= SCAN_MOST then
      n = count_messages(read(e.path))
    else
      uncounted = uncounted + 1
    end
    local row = {topic = topic, messages = n, bytes = e.size}
    push(rows, row)
    if n > 0 then messages = messages + n end
    bytes = bytes + e.size
    -- A modified time of 0 is one the host doesn't know.
    if e.modified > 0 and e.modified < quiet_before then push(quiet, row) end
  end
end

print("topics", #rows, "messages", messages, "bytes", human(bytes))
if uncounted > 0 then print("(" .. uncounted .. " large topics with no count cache are left out of the messages)") end
if cut then print("(stopped at the read budget: the counts above are a part)") end
print("")
sort(rows, "messages")
reverse(rows)
local most = {}
for r in rows do
  if #most < MOST then push(most, r) end
end
print(table(most, {"topic", "messages", "bytes"}))
print("")
print("untouched for " .. QUIET_DAYS .. " days (since " .. date(quiet_before) .. "): " .. #quiet)
if #quiet > 0 then print(table(quiet, {"topic", "messages", "bytes"})) end
print("")
print("count caches that are stale: " .. #stale)
if #stale > 0 then print(table(stale, {"topic", "cache", "taken_at", "size"})) end
