-- Delete one topic, as angry-gopher's chat_retire.zig does: its transcript,
-- its sidecars, and its uploads. Explore first (topics.shale); then name
-- the one to delete here.

local sessions = "chat/channels/general/sessions"
local sid = "plans"

local base = sessions .. "/" .. sid
if not exists(base .. ".md") then
  print("no such topic", base)
  return
end
remove(base .. ".md")
for suffix in {".count", ".lastauthor", ".reactions.jsonl"} do
  if exists(base .. suffix) then remove(base .. suffix) end
end
if is_dir(base .. ".uploads") then remove_tree(base .. ".uploads") end
print("deleted", base)
