-- Check each topic's count cache (its `.count` sidecar, "<count> <size>")
-- against the transcript itself: the messages counted from the separators
-- between them, without holding the transcript (count_all scans it a part
-- at a time, 64 KiB held). A transcript the read budget has no room left
-- for is listed by size alone.

const SEP = "\n\n-------------\n"

-- A topic's label: "#channel sid" or "conversation sid".
function label(path)
  local parts = split(path, "/")
  local sid = strip_suffix(parts[#parts], ".md")
  if parts[2] == "channels" then return "#" .. parts[3] .. " " .. sid end
  return parts[2] .. " " .. sid
end

-- The cache's count, or -1 for no cache (or one torn: no newline).
function cached(md)
  local text = read_or(strip_suffix(md, ".md") .. ".count", nil)
  if text == nil or not ends_with(text, "\n") then return -1 end
  return tonumber(words(lines(text)[1])[1])
end

local rows = {}
local unchecked = {}
for e in walk_all("chat", {like = "*.md", kind = "file"}) do
  local cache = cached(e.path)
  if budget().read_bytes < e.size then
    push(unchecked, {topic = label(e.path), bytes = e.size})
  else
    local counted = 0
    if e.size > 0 then counted = count_all(e.path, SEP) + 1 end
    local verdict = "ok"
    if cache == -1 then
      verdict = "no cache"
    elseif cache ~= counted then
      verdict = "stale"
    end
    push(rows, {topic = label(e.path), cache = cache, counted = counted, verdict = verdict})
  end
end
sort(rows, "topic")
local bad = 0
for r in rows do
  if r.verdict ~= "ok" then bad = bad + 1 end
end
print("topics checked", #rows, "stale or missing", bad)
print(table(rows, {"topic", "cache", "counted", "verdict"}))
if #unchecked > 0 then
  print("")
  print("not counted: past what the read budget had left:")
  print(table(unchecked, {"topic", "bytes"}))
end
