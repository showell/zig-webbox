-- Every topic with its message count: the direct conversations
-- (chat/<a>_<b>/sessions/<sid>.md) and the channels
-- (chat/channels/<name>/sessions/<sid>.md). A message is a block that
-- starts with a line "MSG_<sid>_<n>": counted by count_all, a part at a
-- time, so no transcript is held.

-- The messages in a transcript: each "MSG_" at a line's start.
function messages(path)
  local n = count_all(path, "\nMSG_")
  if starts_with(read(path, 0, 4), "MSG_") then n = n + 1 end
  return n
end

local total = 0
for e in walk_all("chat", {like = "*.md", kind = "file"}) do
  local parts = split(e.path, "/")
  local sid = strip_suffix(parts[#parts], ".md")
  if parts[#parts - 1] == "sessions" then
    local label = parts[2]
    if parts[2] == "channels" then label = "#" .. parts[3] end
    print(label, sid, messages(e.path))
    total = total + 1
  end
end
print("topics", total)
