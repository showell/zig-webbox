-- Every file over a size, with its size, walking the whole data root, or
-- as much of it as the read budget walks: then where the next run goes on
-- (`resume after <path>`: set START to it).

const OVER = 1000
const START = ""

local found = 0
local part = walk_upto("", {kind = "file", after = START}, 0)
for e in part.entries do
  if e.size > OVER then
    print(e.size, e.path)
    found = found + 1
  end
end
print("files over " .. OVER .. " bytes:", found)
if not part.done then print("resume after " .. part.more) end
